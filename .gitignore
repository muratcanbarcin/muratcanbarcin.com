# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*
.env*.local

# private sources & local agent metadata
.cursorrules
cv/
cv/**

# private raw documents (public copies belong in public/assets/documents/)
/*.pdf
/private/
/transcripts/
*.transcript.pdf
!public/assets/
!public/assets/**

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
